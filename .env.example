# ── Agent Hermes — نمونه‌ی متغیرها. این فایل را به ~/.hermes/.env کپی کن و مقدارها را خودت پر کن. ──
# توکن ربات تلگرام (از @BotFather)
TELEGRAM_BOT_TOKEN=
# شناسه‌ی عددی تلگرام کسانی که اجازه دارند (مالک اول)، با کاما جدا
TELEGRAM_ALLOWED_USERS=
# شناسه‌ی گروه‌هایی که ربات در آن‌ها جواب می‌دهد (اختیاری)
TELEGRAM_GROUP_ALLOWED_CHATS=
# کانال/چت خانه برای گزارش‌ها (اختیاری)
TELEGRAM_HOME_CHANNEL=
TELEGRAM_HOME_CHANNEL_THREAD_ID=
# کلید OpenRouter برای مدل‌ها (مدل‌های رایگان هم با همین کلید)
OPENROUTER_API_KEY=
# کلیدهای اختیاری مدل‌های دیگر
GEMINI_API_KEY=
GROQ_API_KEY=
DAHL_API_KEY=
# مقصد بایگانی اسناد روی Google Drive (اسم remote در rclone)
HERMES_ARCHIVE_REMOTE=gdrive:Hermes Archive
# شناسه‌ی عددی تلگرام مالک — در کد به‌صورت 100000001 نوشته شده؛ با شناسه‌ی خودت عوض کن
OWNER_TELEGRAM_ID=
